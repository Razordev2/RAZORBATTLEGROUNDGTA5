# ========================================================
# BATTLEGROUND ESPORTS RESOURCE CONFIGURATION (.env)
# Rename file ini menjadi .env untuk deployment server lokal / VPS
# File .env.example ini aman untuk di-upload ke GitHub repository.
# ========================================================

# Environment Mode (production / development)
NODE_ENV=production
DEBUG_MODE=false
LOCALE=id

# 🗄️ Database Connection Settings (XAMPP / MariaDB / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=battleground_db
DB_CONNECTION_LIMIT=10

# 📢 Discord Webhook Integration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_BOT_NAME="BATTLEGROUND TOURNAMENT ENGINE"
DISCORD_AVATAR_URL="https://i.imgur.com/8N5N6N8.png"

# 🎮 Match & Gameplay Defaults
COUNTDOWN_DURATION=20
ENDING_DURATION=5
RESULTS_DURATION=30
TOTAL_MATCH_VEHICLES=40
REVIVE_DURATION_MS=5000

# 🛡️ Admin Security Identifiers (Comma-separated)
ADMIN_IDENTIFIERS="steam:110000100000000,discord:123456789012345678,license:abcdef1234567890"
